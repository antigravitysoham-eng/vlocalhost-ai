# Brand and social assets are deliberately local-only: anything committed here
# is served, including files never linked from a page. The one exception is
# the logo directory -- the redesign's favicon is served from
# /brand/logo/vlocalhost-appicon.svg, so those SVGs have to ship. The film,
# the social cards and their generators stay out.
brand/*
!brand/logo/
brand/logo/*
!brand/logo/*.svg

# The generators do not live here any more. tools/ was served -- every file in
# this repository is -- which put lead-capture.gs, and with it the id of the
# spreadsheet holding every lead, on vlocal.host as a 200. The generators now
# live in the private app repository; nothing that is not a page belongs here.
tools/
__pycache__/
*.pyc
